# Worker runtime environment. Copy to worker/.env; never commit the real file.
# Keep DUCKCLEAN_HMAC_SECRET identical to WORKER_HMAC_SECRET in api/.dev.vars.
DUCKCLEAN_HMAC_SECRET=replace-with-the-same-secret-as-api/.dev.vars
DUCKCLEAN_KEY_ID=v1
DUCKCLEAN_DEVICE_CLASS=cpu
DUCKCLEAN_WORK_DIR=/tmp/duckclean
