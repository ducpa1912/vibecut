# Copy to web/.env.local. Vite exposes these to the browser; only public keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional. Set only when the Clerk JWT template is named and adds `aud`.
VITE_CLERK_JWT_TEMPLATE=

# Empty in local dev so Vite proxies /api to http://127.0.0.1:8787.
# Production example: https://api.duckclean.app/api/v1
VITE_API_BASE_URL=
