# Local Worker secrets. Copy to `.dev.vars` and fill real values.
# Never commit `.dev.vars`.
APP_ENV=development
API_VERSION=v1

# Clerk. Copy the issuer from the Clerk dashboard (Frontend API URL).
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Leave empty for Clerk's default session token. Set only when a JWT template
# adds this audience; then set VITE_CLERK_JWT_TEMPLATE in web/.env.
CLERK_AUDIENCE=
CLERK_JWKS_URL=
# Development only. A JSON JWKS document lets tests verify a real RS256 token.
AUTH_JWKS_JSON=

# Browser origins allowed to call the API.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# CPU worker. Run `uvicorn duckclean_worker.app:app --port 8799` locally.
CPU_WORKER_URL=http://127.0.0.1:8799
GPU_WORKER_URL=
WORKER_HMAC_SECRET=replace-with-a-long-random-secret
WORKER_HMAC_KEY_ID=v1

# Cloudflare R2. Create a token with Object Read & Write on this bucket.
R2_ACCOUNT_ID=
R2_BUCKET=duckclean-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Billing is M6; leave empty until Stripe is wired.
STRIPE_SECRET_KEY=
STRIPE_METER_EVENT_NAME=
